2  css  

* {
    box-sizing: border-box;
}

.divall {
    width: 100%;
    max-width: 550px;
    margin: 0 auto;
}

#d1 {
    background-color: aqua;
    outline: 5px solid blueviolet;
    text-align: center;

    padding-top: 5px;
    width: 100%;
    height: 40px;
}

#d2 {
    background-color: rgb(255, 55, 0);
    outline: 5px solid blueviolet;
    text-align: center;

    padding-top: 5px;
    margin-top: 5px;

    width: 100%;
    height: 40px;
}



#d3 {
    background-color: brown;
    outline: 5px solid blueviolet;
margin-top: 25px;
    text-align: center;
    padding-top: 55px;

    width: 50%;
    height: 160px;
}

#d4 {
    background-color: rgb(58, 165, 42);
    outline: 5px solid blueviolet;

    text-align: center;
    padding-top: 55px;
margin-left: 50%;
    width: 50%;
    height: 160px;
    margin-top: -160px;
}

#d5 {
    background-color: blue;
    outline: 5px solid blueviolet;
    text-align: center;

    padding-top: 5px;
    margin-top: 5px;

    width: 100%;
    height: 40px;
}






img{
    margin-bottom: 60px;
}

@media(max-width:550px){


#d1 , #d2 , #d5 {

    width: 100%;
    
}

#d3{

    width: 100%;
    height: 200px;
    padding-top: 100px;
    margin-top: 25px;
}
#d4{


    width: 100%;
    height: 200px;
    padding-top: 100px;
    margin-top: 5px;
    margin-left: 0px;

}





}

